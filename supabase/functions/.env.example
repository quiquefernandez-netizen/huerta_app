# Orígenes autorizados, separados por coma. Añade aquí la URL exacta de GitHub Pages.
ALLOWED_ORIGINS=http://127.0.0.1:4173,http://localhost:4173,https://usuario.github.io

# Valor aleatorio largo usado únicamente para anonimizar la dirección del cliente.
RATE_LIMIT_PEPPER=cambia-este-valor-en-los-secretos-de-supabase

# SUPABASE_URL, SUPABASE_PUBLISHABLE_KEYS y SUPABASE_SECRET_KEYS los proporciona
# automáticamente Supabase al ejecutar la Edge Function desplegada.
